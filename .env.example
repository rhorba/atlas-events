# Atlas Events — Environment Variables
# Copy this file to .env for local development.
# NEVER commit .env to git. This file (.env.example) is safe to commit.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/atlasevents
DATABASE_USERNAME=atlas
DATABASE_PASSWORD=atlas_local_password

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=atlas
RABBITMQ_PASSWORD=atlas_local_rabbit

# ── atlas-api: JWT (min 32 random bytes, base64-encoded in production) ───────
JWT_SECRET=local_dev_jwt_secret_change_in_production_32chars_minimum

# ── atlas-api: Admin credentials ─────────────────────────────────────────────
# In production: ADMIN_PASSWORD should be a bcrypt hash generated at deploy time
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_local_password

# ── atlas-api: CORS ───────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── atlas-api: Server ─────────────────────────────────────────────────────────
APP_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ── atlas-scraper: Scheduler ─────────────────────────────────────────────────
# Cron expression — default: every 6 hours
SCRAPER_CRON=0 0 */6 * * *

# ── atlas-scraper: Server (management/health only) ───────────────────────────
SCRAPER_PORT=8081
SCRAPER_PROFILES_ACTIVE=local

# ── atlas-web (Angular environment) ──────────────────────────────────────────
# Set in environment.ts, not .env — listed here for reference
# API_URL=http://localhost:8080
# APP_ENV=local
